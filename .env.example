# Public site URL (no trailing slash) - used for SEO, sitemap, canonical URLs
NEXT_PUBLIC_SITE_URL=https://adiyogitechventures.com

# Resend - https://resend.com (free tier: 3000 emails/mo)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=adiyogitechventures@gmail.com
CONTACT_FROM_EMAIL=Adiyogi Website <onboarding@resend.dev>

# Sentry error monitoring - https://sentry.io (optional; all of this is no-op if unset)
# The DSN is safe to expose; it only allows writing events.
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxx@oNNNNNN.ingest.sentry.io/NNNNNNN
# The three below enable readable stack traces by uploading source maps at build
# time. Set them in Vercel only - SENTRY_AUTH_TOKEN is a secret, never commit it.
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=adiyogitechventures
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxx
